{
  "expo": {
    "name": "ক্ষুদ্র সঞ্চয়",
    "slug": "khudro-sanchoy",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo.png",
    "userInterfaceStyle": "light",
    "scheme": "khudrosanchoy",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "icon": "./assets/logo.png",
      "predictiveBackGestureEnabled": false,
      "package": "com.abdul_alim_sarkar.khudrosanchoy"
    },
    "web": {
      "favicon": "./assets/logo.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-status-bar",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 1000,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e8d38a24-e520-4ac9-918b-f7858c3d424d"
      }
    }
  }
}